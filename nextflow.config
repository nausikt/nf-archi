
manifest {
    name            = 'nausikt/nf-archi'
    description     = 'Archi benchmarking, bootstrapping and prelabelling pipeline'
    author          = 'Nausikt'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '0.1.0'
}

plugins {
    id 'nf-schema@2.2.0'
}

validation {
    help {
        enabled = true
    }
    summary {
        beforeText = "Pipeline starting..."
    }
}

params {
    outdir = "results"

    embed {
        endpoint   = "http://submit76.mit.edu:7870"
        model      = "qwen3-embedding:8b"
        text_fields = ['question', 'answer']
        batch_size = 64
        max_forks  = 4     // concurrent embed chunks (one per input batch/month)
    }

    reduce {
        seed = 42

        // shared PCA pre-reduction (clamped to n_samples-1 at runtime)
        pca_components = 50

        // clustering space (UMAP): tight, density-preserving for HDBSCAN
        n_components = 10
        n_neighbors  = 10
        min_dist     = 0.0

        // viz space (UMAP): spread, 2D for the dashboard
        viz {
            n_neighbors = 15
            min_dist    = 0.1
        }

        // optional sweep: axes (subset ok) cross-product into reduction variants,
        // each becoming an ensemble axis. Unspecified axes use the scalars above.
        // e.g. grid = [ n_components: [5, 10], n_neighbors: [10, 30] ]
        grid = null
    }

    cluster {
        runs = "${projectDir}/assets/cluster/runs.json"
        seed = 42

        // space of the input vectors: 'euclidean' for reduced UMAP coords
        // (no re-normalization), 'cosine' to L2-normalize raw embeddings.
        metric_space = 'euclidean'

        grid = null
    }

    ensemble {
        // min mean co-association for samples to stay in the same consensus cluster
        threshold = 0.5

        // base soft-vote weight for a kept member: 'silhouette' | 'uniform'
        weight = 'silhouette'

        // Tier-0 auto-drop: a member gets weight 0 if it is degenerate
        auto {
            min_clusters  = 2      // < 2 clusters carries no partition information
            max_noise     = 0.6    // mostly-noise members are uninformative
            max_dominance = 0.9    // one giant cluster ~ a trivial partition
        }

        // human curation: override resolved weights by run name (wins over auto),
        // e.g. member_weights = [ hdbscan_mcs5_ms5: 0.0, kmeans_k4: 2.0 ]
        // inspect results/bootstrapping/member_weights.json, then -resume.
        member_weights = [:]
    }

    anchors {
        // fields of each anchor concatenated before embedding (same space as data)
        text_fields = ['name', 'definition']

        // user priors for pre-labeling, grouped by kind (section name == kind):
        //   categories | tags | flags. Absent -> the overlay is skipped.
        // provide via -params-file (see assets/examples/params/demo.yaml)
    }

    assign {
        top_k = 3
    }

    representatives {
        n_medoid   = 3
        n_boundary = 5     // the ambiguous review queue — usually want more
        n_outlier  = 3
    }

    // Final hop: push the prelabels + representatives to your own Argilla instance
    // as a human review queue. Opt-in (needs anchors). Bring-your-own: supply the
    // url/key via $ARGILLA_API_URL / $ARGILLA_API_KEY (the key never lands in logs).
    // The dataset is named "archi-bootstrap-<version>"; bump `version` each pass.
    argilla {
        enabled    = false
        api_url    = null              // falls back to $ARGILLA_API_URL
        workspace  = 'argilla'
        version    = 'v0.0.1'          // iterative review pass -> dataset archi-bootstrap-v0.0.1
        scope      = 'representatives' // 'representatives' (review subset) | 'all'
        top_k_tags = 5                 // ranked tag/flag suggestions kept per record
        overwrite  = false             // replace the dataset if it already exists
        dry_run    = false             // build + preview records without uploading
    }
}

// Emit the workflow DAG on every run (incl. -preview) as mermaid, alongside the
// published outputs so the Svelte Flow workbench picks it up at ./data/. Mirrors
// the publishDir convention ("${params.outdir}/bootstrapping").
dag {
    enabled   = true
    file      = "${params.outdir}/bootstrapping/pipeline_dag.mmd"
    overwrite = true
}

profiles {

    // Minimal demo  : nextflow run . -profile demo_bootstrapping,conda
    //   -> clusters from assets/cluster/runs.json, anchor overlay skipped.
    // Full demo      : add  -params-file assets/examples/params/demo.yaml
    //   -> grid sweep + anchor pre-labeling overlay.
    demo_bootstrapping {
        params {
            workflow = 'bootstrapping'
            input    = "${projectDir}/assets/tests/inputs/2026-06-06/"
        }
    }

    crab_bootstrapping {
        params {
            workflow = 'bootstrapping'
            input    = "${projectDir}/assets/inputs/crab-talk/"
        }
    }


    demo_prelabelling {
        params {
            workflow = 'prelabelling'
            input    = "${projectDir}/assets/tests/inputs/2026-06-06/"
        }
    }

    demo_benchmarking {
        params {
            workflow = 'benchmarking'
            queries  = "${projectDir}/assets/tests/inputs/2026-06-06/"
            configs  = "${projectDir}/assets/tests/configs/"
        }
    }

    test {
        params {
            outdir = "test_results"
        }
        process {
            cpus   = 1
            memory = '2.GB'
        }
    }

    docker {
        docker.enabled = true
    }

    conda {
        conda.enabled = true
        conda.useMicromamba = true
    }

    singularity {
        singularity.enabled = true
    }
}
