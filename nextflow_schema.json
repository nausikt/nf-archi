{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "nextflow_schema.json",
    "title": "Pipeline Parameters",
    "type": "object",
    "$defs": {

        "common": {
            "title": "Common",
            "type": "object",
            "properties": {
                "outdir": {
                    "type": "string",
                    "description": "Directory for pipeline outputs",
                    "default": "results"
                },
                "workflow": {
                    "type": "string",
                    "description": "Which workflow to run",
                    "enum": ["benchmarking", "bootstrapping", "prelabelling"]
                }
            },
            "required": ["workflow"]
        },

        "bootstrapping": {
            "title": "Bootstrapping",
            "type": "object",
            "properties": {
                "input": {
                    "type": "string",
                    "description": "Path or glob to query files (.json or .jsonl)"
                },
                "embed": {
                    "type": "object",
                    "description": "Embedding settings (Ollama)",
                    "properties": {
                        "endpoint":   { "type": "string",  "default": "http://submit76.mit.edu:7870"},
                        "model":      { "type": "string",  "default": "qwen3-embedding:8b" },
                        "text_fields": { "type": "array", "items": { "type": "string" }, "default": ["question", "answer"] },
                        "batch_size": { "type": "integer", "default": 64 }
                    }
                },
                "reduce": {
                    "type": "object",
                    "description": "Dimensionality reduction (PCA -> UMAP) before clustering",
                    "properties": {
                        "seed":           { "type": "integer", "default": 42 },
                        "pca_components": { "type": "integer", "default": 50, "description": "Shared PCA pre-reduction (clamped to n_samples-1)" },
                        "n_components":   { "type": "integer", "default": 10, "description": "Clustering-space UMAP dimensionality" },
                        "n_neighbors":    { "type": "integer", "default": 10, "description": "Clustering-space UMAP neighborhood size" },
                        "min_dist":       { "type": "number",  "default": 0.0, "description": "Clustering-space UMAP packing (0 = tight, density-preserving)" },
                        "viz": {
                            "type": "object",
                            "description": "Viz-space UMAP (2D)",
                            "properties": {
                                "n_neighbors": { "type": "integer", "default": 15 },
                                "min_dist":    { "type": "number",  "default": 0.1 }
                            }
                        },
                        "grid": {
                            "type": ["object", "null"],
                            "default": null,
                            "description": "Reduction sweep; when set, axes cross-product into variants (each an ensemble axis). Keys pca_components|n_components|n_neighbors|min_dist -> [values]. Deep-validated against schemas/reduce/grid.json"
                        }
                    }
                },
                "cluster": {
                    "type": "object",
                    "description": "Clustering ensemble settings",
                    "properties": {
                        "runs": { "type": "string", "description": "Path to ensemble runs JSON" },
                        "seed": { "type": "integer", "default": 42 },
                        "metric_space": {
                            "type": "string",
                            "enum": ["euclidean", "cosine"],
                            "default": "euclidean",
                            "description": "Input vector space: 'euclidean' for reduced UMAP coords (no re-normalization), 'cosine' to L2-normalize raw embeddings"
                        },
                        "grid": {
                            "type": ["object", "null"],
                            "default": null,
                            "description": "Hyperparameter grid; when set, overrides runs.json. Keys hdbscan|kmeans|agglomerative -> {param: [values]}. Deep-validated against schemas/cluster/grid.json"
                        }
                    }
                },
                "ensemble": {
                    "type": "object",
                    "description": "Weighted evidence-accumulation consensus (semi-automatic)",
                    "properties": {
                        "threshold": {
                            "type": "number",
                            "default": 0.5,
                            "description": "Min mean co-association for samples to stay in the same consensus cluster"
                        },
                        "weight": {
                            "type": "string",
                            "enum": ["silhouette", "uniform"],
                            "default": "silhouette",
                            "description": "Base soft-vote weight for a kept member"
                        },
                        "auto": {
                            "type": "object",
                            "description": "Tier-0 auto-drop policy (degenerate member -> weight 0)",
                            "properties": {
                                "min_clusters":  { "type": "integer", "default": 2, "description": "Members with fewer clusters are dropped" },
                                "max_noise":     { "type": "number",  "default": 0.6, "description": "Members noisier than this are dropped" },
                                "max_dominance": { "type": "number",  "default": 0.9, "description": "Members whose largest cluster exceeds this fraction are dropped" }
                            }
                        },
                        "member_weights": {
                            "type": "object",
                            "default": {},
                            "description": "Human override of resolved weights, keyed by run name (wins over auto-drop)"
                        }
                    }
                },
                "anchors": {
                    "type": "object",
                    "description": "Pre-labeling anchors (user priors embedded into the data space). Provide via -params-file; deep-validated against schemas/anchors/taxonomy.json",
                    "properties": {
                        "text_fields": { "type": "array", "items": { "type": "string" }, "default": ["name", "definition"] },
                        "categories":  { "type": ["array", "null"], "default": null, "description": "Mutually-exclusive intent anchors {id, name, definition}" },
                        "tags":        { "type": ["array", "null"], "default": null, "description": "Multi-select topic anchors {id, name, definition}" },
                        "flags":       { "type": ["array", "null"], "default": null, "description": "Multi-select meta-judgment anchors {id, name, definition}" }
                    }
                },
                "assign": {
                    "type": "object",
                    "description": "Anchor assignment settings",
                    "properties": {
                        "top_k": { "type": "integer", "default": 3, "description": "Ranked nearest-anchor suggestions per sample/cluster" }
                    }
                },
                "representatives": {
                    "type": "object",
                    "description": "Per-cluster representative sampling for expert review",
                    "properties": {
                        "n_medoid":   { "type": "integer", "default": 3, "description": "Most-typical records per cluster (nearest centroid)" },
                        "n_boundary": { "type": "integer", "default": 5, "description": "Most ambiguous records per cluster (smallest margin)" },
                        "n_outlier":  { "type": "integer", "default": 3, "description": "Most anomalous records per cluster (far from all / noise)" }
                    }
                },
                "argilla": {
                    "type": "object",
                    "description": "Argilla export of prelabels + representatives as a review queue (opt-in; bring-your-own instance, api key via $ARGILLA_API_KEY)",
                    "properties": {
                        "enabled":    { "type": "boolean", "default": false, "description": "Run the export as the last bootstrapping step" },
                        "api_url":    { "type": ["string", "null"], "default": null, "description": "Your Argilla server URL; falls back to $ARGILLA_API_URL" },
                        "workspace":  { "type": "string", "default": "argilla", "description": "Target Argilla workspace" },
                        "version":    { "type": "string", "default": "v0.0.1", "description": "Iterative review pass; dataset name = archi-bootstrap-<version>" },
                        "scope":      { "type": "string", "enum": ["representatives", "all"], "default": "representatives", "description": "Export the review subset or every sample" },
                        "top_k_tags": { "type": "integer", "default": 5, "description": "Ranked tag/flag suggestions kept per record" },
                        "overwrite":  { "type": "boolean", "default": false, "description": "Replace the dataset if it already exists" },
                        "dry_run":    { "type": "boolean", "default": false, "description": "Build + preview records without uploading" }
                    }
                }
            }
        },

        "benchmarking": {
            "title": "Benchmarking",
            "type": "object",
            "properties": {
                "queries": {
                    "type": "string",
                    "description": "Path or glob to query files"
                },
                "configs": {
                    "type": "string",
                    "description": "Path to directory containing archi configs"
                }
            }
        }
    },

    "allOf": [
        { "$ref": "#/$defs/common" },
        { "$ref": "#/$defs/bootstrapping" },
        { "$ref": "#/$defs/benchmarking" },

        {
            "if":   { "properties": { "workflow": { "const": "bootstrapping" } } },
            "then": { "required": ["input"] }
        },
        {
            "if":   { "properties": { "workflow": { "const": "benchmarking" } } },
            "then": { "required": ["queries", "configs"] }
        },
        {
            "if":   { "properties": { "workflow": { "const": "prelabelling" } } },
            "then": { "required": ["input"] }
        }
    ]
}
